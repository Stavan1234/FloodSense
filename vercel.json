{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "env": {
    "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
  },
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{.venv/**,**/__pycache__/**,*.ipynb,*.zip,*.pdf,README.txt,*.md,*.bat,.claude/**}"
    }
  }
}
